NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reels
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
SLACK_USER_SCOPES=im:history,im:read,users:read,chat:write

# The only delivery channel: reels, instant cards and reply drafts all go out through this bot.
# @BotFather -> /newbot, then `pnpm telegram:check` to validate (see TELEGRAM-SETUP.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=reelrelay_demo_bot

# Composio handles inbound only: OAuth to each inbox plus the triggers that push new messages to us.
# Supported toolkits: gmail, slack, outlook, whatsapp, instagram. All values are server-only.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# Start with Gmail/Slack. Add Outlook/WhatsApp/Instagram only after copying their exact current trigger slugs
# from the Composio dashboard — a stale slug makes the webhook drop events as "unexpected_trigger".
COMPOSIO_AUTH_CONFIGS={"gmail":"ac_your_gmail_config","slack":"ac_your_slack_config"}
COMPOSIO_TRIGGER_SLUGS={"gmail":"GMAIL_NEW_GMAIL_MESSAGE","slack":"SLACK_DIRECT_MESSAGE_RECEIVED"}
COMPOSIO_TRIGGER_CONFIGS={"gmail":{"query":"label:inbox","labelIds":"INBOX","interval":2},"slack":{}}
COMPOSIO_API_BASE_URL=https://backend.composio.dev

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# With auto, OPENAI_API_KEY selects OpenAI; otherwise Anthropic is used.
# The demo aliases LLM_PROVIDER=openai and LLM_API_KEY are also accepted.
ENGINE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: leave empty to automatically choose an available stock voice.
ELEVENLABS_VOICE_ID=

# Generate separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
DEMO_INJECT_SECRET=

RENDER_TIMEOUT_MS=150000
REEL_WIDTH=720
REEL_HEIGHT=1280
# Explicit development opt-ins; live mode never silently substitutes a canned interpretation.
ENGINE_MODE=live
PIPELINE_MODE=video
DATA_DIR=build/reelrelay

# Pivot 03 demo: freeze the triage clock (ISO with offset), e.g. 2026-09-15T23:10:00-04:00. Leave empty for real time.
DEMO_NOW=
