NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reels
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
SLACK_USER_SCOPES=im:history,im:read,users:read,chat:write

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=reelrelay_demo_bot

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: leave empty to automatically choose an available stock voice.
ELEVENLABS_VOICE_ID=

# Generate separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
DEMO_INJECT_SECRET=

RENDER_TIMEOUT_MS=150000
REEL_WIDTH=720
REEL_HEIGHT=1280
# Explicit development opt-ins; live mode never silently substitutes a canned interpretation.
ENGINE_MODE=live
PIPELINE_MODE=video
DATA_DIR=build/reelrelay
